# ========================================
# MedRepAI Configuration File (EXAMPLE)
# ========================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# ========================================
# MongoDB Configuration
# ========================================
# MongoDB Atlas connection URL
# Replace <db_password> with your actual MongoDB password
MONGODB_URL=mongodb+srv://admin:<db_password>@medrepai.zw5as5g.mongodb.net/

# Database name - CHANGE THIS FOR EACH CLIENT
# Example: medrepai_xyzpharma_db, medrepai_abchealthcare_db
DATABASE_NAME=medrepai_company1_db

# ========================================
# JWT (Authentication) Configuration
# ========================================
# Secret key for signing JWT tokens
# Generate a strong random key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters

# JWT algorithm (don't change unless you know what you're doing)
ALGORITHM=HS256

# Token expiration time in minutes (60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========================================
# Application Configuration
# ========================================
APP_NAME=MedRepAI
APP_VERSION=1.0.0

# Debug mode (set to False in production)
DEBUG=True

# ========================================
# NER API Configuration (Intelligent Drug Search)
# ========================================
# NER (Named Entity Recognition) API endpoint
NER_API_URL=https://ner-medrep.onrender.com/predict

# NER API timeout in seconds (30s for Render cold starts)
NER_API_TIMEOUT=30

# ========================================
# Email Configuration (Gmail SMTP)
# ========================================
# Gmail SMTP settings for sending invitation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail account credentials
# IMPORTANT: Use Gmail App Password, not your regular password
# How to get App Password:
# 1. Enable 2-Factor Authentication on your Gmail
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use that 16-character password here
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Email sender information
SMTP_FROM_EMAIL=noreply@medrep.com
SMTP_FROM_NAME=MedRep Platform

# ========================================
# Frontend Configuration
# ========================================
# Frontend URL for login links in emails
FRONTEND_URL=http://localhost:3000

# ========================================
# Cloudinary Configuration (File Storage)
# ========================================
# Cloudinary credentials for storing drug brochures/PDFs
# Get your credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ========================================
# AI Configuration (Groq API)
# ========================================
# Groq API key for AI report analysis
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# ========================================
# Logging Configuration
# ========================================
# Log directory (outside project for persistence)
# Windows: C:\Logs\MedRep_AI
# Linux Production: /var/log/medrep_ai
# Linux Development: ~/.medrep_ai/logs
# Leave empty to use platform-specific default
LOG_DIR=C:\Logs\MedRep_AI

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: DEBUG or INFO (shows all logs)
# Production: INFO or WARNING (reduces noise)
LOG_LEVEL=INFO
GROQ_API_KEY=your-groq-api-key-here

# ========================================
# MongoDB Atlas API Configuration
# ========================================
# Atlas API credentials for creating database users via REST API
# Get these from: Atlas → Access Manager → API Keys → Create API Key
# Required permissions: Project Owner or Organization Owner
ATLAS_PUBLIC_KEY=your-atlas-public-api-key-here
ATLAS_PRIVATE_KEY=your-atlas-private-api-key-here

# Atlas Project ID (Group ID)
# Get from: Atlas → Project Settings → Project ID
ATLAS_PROJECT_ID=your-atlas-project-id-here

# Password for the new clientAdmin database user
# This will be used by the create_client_admin.py script
# Use a strong password (min 8 chars, uppercase, lowercase, number, special char)
CLIENT_ADMIN_PASSWORD=YourStrongPassword@123

# ========================================
# Proxzar OAuth2 Configuration
# ========================================
# Proxzar is the ONLY authentication provider for MRX.
# MRX verifies Proxzar-issued JWTs using JWKS.
PROXZAR_ISSUER=https://oauth2.proxzar.ai
PROXZAR_JWKS_URL=https://oauth2.proxzar.ai/api/v1/jwks
PROXZAR_AUDIENCE=MRX
PROXZAR_JWKS_CACHE_TTL=3600
